{
  "compilerOptions": {
    // Target modern Node.js — ES2022 gives us top-level await and class fields
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",

    // Output compiled JS to dist/
    "outDir": "./dist",
    "rootDir": "./src",

    // Type safety
    "strict": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,

    // Skip type checking on declaration files from node_modules
    "skipLibCheck": true,

    // Source maps for easier debugging
    "sourceMap": true,

    // Don't emit if there are type errors
    "noEmitOnError": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
